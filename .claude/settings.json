{
  "permissions": {
    "allow": [
      "Bash(php -r \"echo extension_loaded\\('gd'\\) ? 'GD ok' : 'no GD';\")",
      "Bash(php -r \"echo extension_loaded\\('gd'\\) ? 'GD ok' : 'no GD'; echo PHP_EOL; print_r\\(gd_info\\(\\)\\);\")",
      "Bash(python3 -c \"from PIL import Image; img = Image.open\\('/var/www/html/pindoor/public/favicon.ico'\\); img.save\\('/var/www/html/pindoor/public/favicon.png', 'PNG'\\); print\\('ok'\\)\")",
      "Bash(git -C /var/www/html/pindoor status public/favicon.png)",
      "Bash(git -C /var/www/html/pindoor add public/favicon.png resources/views/layouts/pindoor.blade.php resources/views/layouts/app.blade.php)",
      "Bash(git -C /var/www/html/pindoor commit -m ' *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://127.0.0.1:8000/)",
      "Bash(git -C /var/www/html/pindoor diff --staged)",
      "Bash(git -C /var/www/html/pindoor diff routes/web.php)",
      "Bash(git -C /var/www/html/pindoor diff resources/views/layouts/pindoor.blade.php)",
      "Bash(git -C /var/www/html/pindoor diff vite.config.js)",
      "Bash(git -C /var/www/html/pindoor diff .claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /var/www/html/pindoor/scripts/check-seo.sh",
            "timeout": 10,
            "statusMessage": "Verificando SEO..."
          }
        ]
      }
    ]
  }
}
